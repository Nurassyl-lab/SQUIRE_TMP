#!/bin/bash

### Modify the variables below ###
ROOT=path/REPO_ROOT_FOLDER
dataType="single/multi" # choose either "single" or "multi"
USE_PARAPHRASED=true/false # choose either "true" or "false"
CONDA_ENV=name_env # name of the conda environment
SEED=42 # change the seed for reproducibility
NUM_EPOCH=500 # number of epochs for training
##################################

if [ "$USE_PARAPHRASED" = true ]; then
    TEST_PARAPHRASED="--test-paraphrased"
else
    TEST_PARAPHRASED=""
fi


BASE_DIR=$ROOT
DATASET=mquake_st
CONFIG=config-mquake-st-qa.properties
SNAPSHOT_FOLDER=path_mquake_st_qa


PATH2DATA=$ROOT/data/$DATASET
PATH2AnyBURL=$ROOT/AnyBURL
PATH2CONFIG=$ROOT/AnyBURL/$CONFIG
PATH2SNAPSHOT=$PATH2AnyBURL/$SNAPSHOT_FOLDER/path-1000

if [ "$dataType" = "multi" ]; then
    PATH2CSV=$ROOT/data/$DATASET/reconstructed.csv
else
    PATH2CSV=$ROOT/data/$DATASET/qa_nhop.csv
fi

if [ "$dataType" = "multi" ]; then
    PATH2CSV_EVAL=$ROOT/data/$DATASET/qa_nhop_multi_answer.csv
else
    PATH2CSV_EVAL=$ROOT/data/$DATASET/qa_nhop.csv
fi

echo "Using dataset: $DATASET"
echo "Using data type: $dataType"
echo "Path to evaluation CSV: $PATH2CSV_EVAL"

HOP_NUM=4 # max number of hops in the dataset

TRAIN_BATCH_SIZE=256
TEST_BATCH_SIZE=32
BEAM_SIZE=64

EMBEDDING_SIZE=100
HIDDEN_SIZE=128

NUM_RULES_FILTER=40 # number of rules to keep after filtering with AnyBURL.

MODEL_FOLDER="models_pretrained"
if [ "$dataType" = "multi" ]; then
    MODEL_SAVE=$ROOT/$MODEL_FOLDER/mquake_st_qa_multi_answer
else
    MODEL_SAVE=$ROOT/$MODEL_FOLDER/mquake_st_qa
fi

case "$1" in
    step1)
        echo "Step 1: Verify that the required data files are present in $PATH2DATA"
        if [ ! -f "$PATH2DATA/train.txt" ]; then
            echo "Error: train.txt not found in $PATH2DATA"
            exit 1
        fi
        if [ ! -f "$PATH2DATA/test.txt" ]; then
            echo "Error: test.txt not found in $PATH2DATA"
            exit 1
        fi
        if [ ! -f "$PATH2DATA/valid.txt" ]; then
            echo "Error: valid.txt not found in $PATH2DATA"
            exit 1
        fi
        if [ ! -f "$PATH2CSV" ]; then
            echo "Error: $PATH2CSV not found"
            exit 1
        fi
        if [ ! -f "$PATH2CONFIG" ]; then
            echo "Error: $PATH2CONFIG not found"
            exit 1
        fi
        echo "  *All required files are present."
        echo "================================"
        ;;
    step2)
        echo "Step 2: Generate mapping and evaluation data using utils.py"
        PYTHONPATH="$BASE_DIR" conda run -n squire python "$BASE_DIR/data/utils.py" \
            --dataset $PATH2DATA \
            --gen-mapping \
            --skip-reverse-augmentation \
            --gen-eval-data
        
        if [ ! -f "$PATH2DATA/train_triples_rev.txt" ]; then
            echo "Error: train_triples_rev.txt not found in $PATH2DATA"
            exit 1
        fi
        if [ ! -f "$PATH2DATA/train_triples.txt" ]; then
            echo "Error: train_triples.txt not found in $PATH2DATA"
            exit 1
        fi
        if [ ! -f "$PATH2DATA/test_triples_rev.txt" ]; then
            echo "Error: test_triples_rev.txt not found in $PATH2DATA"
            exit 1
        fi
        if [ ! -f "$PATH2DATA/test_triples.txt" ]; then
            echo "Error: test_triples.txt not found in $PATH2DATA"
            exit 1
        fi
        if [ ! -f "$PATH2DATA/valid_triples_rev.txt" ]; then
            echo "Error: valid_triples_rev.txt not found in $PATH2DATA"
            exit 1
        fi
        if [ ! -f "$PATH2DATA/valid_triples.txt" ]; then
            echo "Error: valid_triples.txt not found in $PATH2DATA"
            exit 1
        fi
        if [ ! -f "$PATH2DATA/relation2id.txt" ]; then
            echo "Error: relation2id.txt not found in $PATH2DATA"
            exit 1
        fi
        if [ ! -f "$PATH2DATA/entity2id.txt" ]; then
            echo "Error: entity2id.txt not found in $PATH2DATA"
            exit 1
        fi
        echo "  *All required files for training and evaluation have been generated."
        echo "================================"
        ;;
    step3)
        echo "Step 3 Run AnyBURL with the configuration file $PATH2CONFIG"
        (
            cd "$BASE_DIR/AnyBURL" || exit 1

            mkdir -p $SNAPSHOT_FOLDER

            if ! grep -qE "$SNAPSHOT_FOLDER" "$PATH2CONFIG"; then
                echo "Error: SNAPSHOT_FOLDER not found in config file"
                exit 1
            fi

            java -Xmx1G -cp AnyBURL-JUNO.jar \
            de.unima.ki.anyburl.LearnReinforced \
            $CONFIG
        )
        echo "================================"
        ;;
    step4)
        echo "Step 4: Generate AnyBURL rules"

        echo "  *NUM_RULES_FILTER: $NUM_RULES_FILTER"

        echo "  *Generating filtered rules and training data with NUM_RULES_FILTER=$NUM_RULES_FILTER"
        PYTHONPATH="$BASE_DIR" conda run -n squire python "$BASE_DIR/AnyBURL/utils.py" \
            --dataset $PATH2DATA \
            --path $PATH2SNAPSHOT \
            --num $NUM_RULES_FILTER \
            --ratio 0.6

        PYTHONPATH="$BASE_DIR" conda run -n squire python "$BASE_DIR/check_relations.py" \
            --path $PATH2DATA/rules.dict

        echo "  *Generating training data with the filtered rules"
        PYTHONUNBUFFERED=1 PYTHONPATH="$BASE_DIR" conda run --no-capture-output -n squire python "$BASE_DIR/data/utils.py" \
            --dataset $PATH2DATA \
            --gen-train-data \
            --num $NUM_RULES_FILTER \
            --max-len $HOP_NUM \
            --out ${NUM_RULES_FILTER}_rev_rule \
            --skip-reverse-augmentation

        echo "================================"
        ;;
    train)
        echo "Finally Training..."

        PYTHONUNBUFFERED=1 PYTHONPATH="$BASE_DIR" conda run --no-capture-output -n squire python "$BASE_DIR/train.py" \
            --mode train \
            --encoder \
            --dataset $DATASET \
            --trainset ${NUM_RULES_FILTER}_rev_rule \
            --max-len $HOP_NUM \
            --num-epoch $NUM_EPOCH \
            --batch-size $TRAIN_BATCH_SIZE \
            --test-batch-size $TEST_BATCH_SIZE \
            --beam-size $BEAM_SIZE \
            --save-dir $MODEL_SAVE \
            --num-workers 4 \
            --validate-during-training \
            --validate-interval 1 \
            --embedding-dim $EMBEDDING_SIZE \
            --hidden-size $HIDDEN_SIZE \
            --seed $SEED \
            --train-question-file $PATH2CSV \
            --eval-question-file $PATH2CSV_EVAL
            # --question-file $PATH2CSV \
        
        # echo "  *Training completed. Model saved to $MODEL_SAVE"
        echo "================================"
        ;;
    eval)
        echo "Evaluation only"

        CKPT_NAME=${2:-best_model.pt}

        if [ ! -f "$MODEL_SAVE/checkpoint/$CKPT_NAME" ]; then
            echo "Error: checkpoint $MODEL_SAVE/checkpoint/$CKPT_NAME not found"
            exit 1
        fi

        PYTHONUNBUFFERED=1 PYTHONPATH="$BASE_DIR" conda run --no-capture-output -n $CONDA_ENV python "$BASE_DIR/evaluation.py" \
            --encoder \
            --dataset $DATASET \
            --max-len $HOP_NUM \
            --beam-size $BEAM_SIZE \
            --test-batch-size $TEST_BATCH_SIZE \
            --save-dir $MODEL_SAVE \
            --ckpt $CKPT_NAME \
            --question-file $PATH2CSV_EVAL \
            --num-workers 4 \
            --output-path \
            --embedding-dim $EMBEDDING_SIZE \
            --hidden-size $HIDDEN_SIZE \
            $TEST_PARAPHRASED

        echo "  *Evaluation completed using $MODEL_SAVE/checkpoint/$CKPT_NAME"
        echo "================================"
        ;;
    *)
        echo "Usage: bash run.sh [step1|step2|step3|step4|train|eval]"
        exit 1
        ;;
esac
